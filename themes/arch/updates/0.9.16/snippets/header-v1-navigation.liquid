{% if header_settings.header_links.size > 0 %}
  <nav class="header-nav header-three-region-nav" aria-label="{{ header_settings.nav_label | default: 'Primary' }}">
    <ul class="nav-list" style="--header-nav-item-spacing: {{ header_settings.navigation_item_spacing | default: 8 }}px;">
      {% for header_link in header_settings.header_links %}
        {% if header_link.label != blank %}
          {% if header_link.destination != blank and header_link.destination_type == 'page' %}
            {% assign header_href = header_link.destination | page_url %}
          {% elsif header_link.destination != blank %}
            {% assign header_href = header_link.destination | safe_url %}
          {% endif %}
          {% if header_href and header_href.size > 0 %}
            <li class="nav-item">
              <a href="{{ header_href }}" class="nav-link{% if header_link.presentation == 'button' %} nav-link--button widget-button widget-button-{{ header_settings.ctaButtonStyle | default: 'secondary' }}{% endif %}"{% if header_link.open_in_new_tab == true or header_link.open_in_new_tab == 'true' %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ header_link.label }}</a>
            </li>
          {% else %}
            <li class="nav-item">
              <span class="nav-link{% if header_link.presentation == 'button' %} nav-link--button widget-button widget-button-{{ header_settings.ctaButtonStyle | default: 'secondary' }}{% endif %}">{{ header_link.label }}</span>
            </li>
          {% endif %}
          {% assign header_href = blank %}
        {% endif %}
      {% endfor %}
    </ul>
  </nav>
{% endif %}
