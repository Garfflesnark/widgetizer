{%- assign copyright_html = widget.settings.copyright | default: '' -%}
{%- assign copyright_text = copyright_html | rte_text -%}
<footer
  id="{{ widget.id }}"
  class="widget widget-footer widget-{{ widget.id }} color-scheme-{{ widget.settings.color_scheme }}"
  data-widget-id="{{ widget.id }}"
  data-widget-type="footer"
  style="{% unless widget.settings.color_scheme == 'standard-primary' %}--widget-bg-color: var(--bg-primary);{% endunless %}{% if copyright_text == blank %} padding-block: 8rem;{% endif %}"
>
  {% if widget.settings.layout != 'equal' %}
  <style>
    .widget-{{ widget.id }} .footer-column:{% if widget.settings.layout == 'last-featured' %}last-child{% else %}first-child{% endif %} {
      grid-column: span 2;
    }
  </style>
  {% endif %}
  <div class="widget-container footer-content">
    {% assign block_count = widget.blocksOrder.size %}
    {% if widget.settings.layout == 'equal' %}
      {% assign grid_cols = block_count %}
    {% else %}
      {% assign grid_cols = block_count | plus: 1 %}
    {% endif %}
    <div class="widget-grid" style="--grid-cols-desktop: {{ grid_cols }}; --grid-gap: var(--space-3xl);">
      {% for blockId in widget.blocksOrder %}
        {% assign block = widget.blocks[blockId] %}

        <div class="footer-column" data-block-id="{{ blockId }}">
          {% case block.type %}
          {% when 'logo_text' %}
            {% if block.settings.logo != blank %}
              <style>.widget-{{ widget.id }} [data-block-id="{{ blockId }}"] .footer-logo { max-width: {{ block.settings.logo_width | default: 100 }}px; height: auto; display: block; }</style>
              {% image src: block.settings.logo, size: 'small', class: 'footer-logo', alt: 'Logo' %}
            {% elsif block.settings.logo_text != blank %}
              <span class="footer-logo-text w-title t-xl t-heading-font" data-setting="logo_text">{{ block.settings.logo_text }}</span>
            {% endif %}
            {% unless block.settings.text | rte_blank %}
              <div class="w-body w-rte t-sm" data-setting="text">{{ block.settings.text | raw }}</div>
            {% endunless %}

          {% when 'text_block' %}
            {% if block.settings.title != blank %}
              <h3 class="w-title t-lg" data-setting="title">{{ block.settings.title }}</h3>
            {% endif %}
            {% unless block.settings.text | rte_blank %}
              <div class="w-body w-rte t-sm" data-setting="text">{{ block.settings.text | raw }}</div>
            {% endunless %}

          {% when 'menu_block' %}
            {% if block.settings.title != blank %}
              <h3 class="w-title t-lg" data-setting="title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.menu %}
              {% render 'menu',
                menu: block.settings.menu,
                aria_label: block.settings.title,
                class_nav: 'footer-nav',
                class_list: 'footer-menu',
                class_item: 'footer-menu-item',
                class_link: 'footer-menu-link',
                class_submenu: 'hidden',
                class_has_submenu: 'hidden'
              %}
            {% endif %}

          {% when 'social_block' %}
            {% if block.settings.title != blank %}
              <h3 class="w-title t-lg" data-setting="title">{{ block.settings.title }}</h3>
            {% endif %}
            {% unless block.settings.show_social_links == false or block.settings.show_social_links == 'false' %}
              {% if block.settings.footer_social_links.size > 0 %}
                {%- assign footer_social_color = block.settings.footer_social_icon_color | default: '' | strip -%}
                {%- assign footer_social_hover = block.settings.footer_social_icon_hover_color | default: '' | strip -%}
                {%- assign footer_social_color_prefix = footer_social_color | slice: 0, 1 -%}
                {%- assign footer_social_hover_prefix = footer_social_hover | slice: 0, 1 -%}
                {%- assign footer_social_color_valid = false -%}
                {%- assign footer_social_hover_valid = false -%}
                {%- if footer_social_color_prefix == '#' and footer_social_color.size == 4 -%}{%- assign footer_social_color_valid = true -%}{%- endif -%}
                {%- if footer_social_color_prefix == '#' and footer_social_color.size == 7 -%}{%- assign footer_social_color_valid = true -%}{%- endif -%}
                {%- if footer_social_hover_prefix == '#' and footer_social_hover.size == 4 -%}{%- assign footer_social_hover_valid = true -%}{%- endif -%}
                {%- if footer_social_hover_prefix == '#' and footer_social_hover.size == 7 -%}{%- assign footer_social_hover_valid = true -%}{%- endif -%}
                <style>
                  .widget-{{ widget.id }} [data-block-id="{{ blockId }}"] .footer-social-custom { display: flex; flex-wrap: wrap; align-items: center; gap: {{ block.settings.footer_social_icon_spacing | default: 8 }}px; }
                  .widget-{{ widget.id }} [data-block-id="{{ blockId }}"] .footer-social-custom-item { display: inline-flex; align-items: center; justify-content: center; width: 4rem; height: 4rem; padding: .8rem; color: {% if footer_social_color_valid %}{{ footer_social_color | escape }}{% else %}var(--text-content){% endif %}; border-radius: var(--radius-sm); }
                  .widget-{{ widget.id }} [data-block-id="{{ blockId }}"] .footer-social-custom-item svg { display: block; width: {{ block.settings.footer_social_icon_size | default: 38 }}px; height: auto; max-height: {{ block.settings.footer_social_icon_size | default: 38 }}px; color: inherit; flex: none; }
                  .widget-{{ widget.id }} [data-block-id="{{ blockId }}"] a.footer-social-custom-item:hover { color: {% if footer_social_hover_valid %}{{ footer_social_hover | escape }}{% else %}var(--accent){% endif %}; }
                  .widget-{{ widget.id }} [data-block-id="{{ blockId }}"] .footer-social-custom-item:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
                </style>
                <div class="footer-social-custom" aria-label="{{ block.settings.title | default: 'Social links' | escape }}">
                  {% for social_item in block.settings.footer_social_links %}
                    {% assign social_icon = social_item.icon | default: 'facebook' %}
                    {% assign social_label = social_item.accessible_label | strip %}
                    {% if social_label == blank %}
                      {% case social_icon %}
                        {% when 'twitter' %}{% assign social_label = 'X / Twitter' %}
                        {% when 'linkedin' %}{% assign social_label = 'LinkedIn' %}
                        {% when 'tiktok' %}{% assign social_label = 'TikTok' %}
                        {% when 'youtube' %}{% assign social_label = 'YouTube' %}
                        {% when 'github' %}{% assign social_label = 'GitHub' %}
                        {% when 'bluesky' %}{% assign social_label = 'Bluesky' %}
                        {% when 'whatsapp' %}{% assign social_label = 'WhatsApp' %}
                        {% else %}{% assign social_label = social_icon | capitalize %}
                      {% endcase %}
                    {% endif %}
                    {% assign social_href = social_item.url | strip | safe_url %}
                    {% if social_href != blank %}
                      <a class="footer-social-custom-item" href="{{ social_href | escape }}" aria-label="{{ social_label | escape }}"{% if social_item.open_in_new_tab == true or social_item.open_in_new_tab == 'true' %} target="_blank" rel="noopener noreferrer"{% endif %}>
                        {% render 'icon', icon: social_icon %}
                      </a>
                    {% else %}
                      <span class="footer-social-custom-item" role="img" aria-label="{{ social_label | escape }}">
                        {% render 'icon', icon: social_icon %}
                      </span>
                    {% endif %}
                  {% endfor %}
                </div>
              {% else %}
                <div class="social-links footer-social">
                  {% render 'social-icons', social: theme.social, identity: project.identity %}
                </div>
              {% endif %}
            {% endunless %}

          {% when 'business_details' %}
            {% unless block.settings.show_contact_information == false or block.settings.show_contact_information == 'false' %}
              {% if block.settings.title != blank %}
                <h3 class="w-title t-lg" data-setting="title">{{ block.settings.title }}</h3>
              {% endif %}
              {% render 'business-details',
                identity: project.identity,
                show_address: block.settings.show_address,
                show_contact: block.settings.show_contact,
                show_hours: block.settings.show_hours,
                text: block.settings.text
              %}
            {% endunless %}

          {% when 'badges_block' %}
            {% if block.settings.title != blank %}
              <h3 class="w-title t-lg" data-setting="title">{{ block.settings.title }}</h3>
            {% endif %}
            <style>.widget-{{ widget.id }} [data-block-id="{{ blockId }}"] .footer-badge-image { max-height: {{ block.settings.max_height | default: 50 }}px; }</style>
            <ul class="footer-badges">
              {% for i in (1..4) %}
                {% assign image_key = 'badge_' | append: i | append: '_image' %}
                {% assign link_key = 'badge_' | append: i | append: '_link' %}
                {% assign badge_image = block.settings[image_key] %}
                {% assign badge_link = block.settings[link_key] %}
                {% if badge_image != blank %}
                  <li class="footer-badge" data-setting="{{ image_key }}">
                    {% if badge_link.href != blank %}
                      <a href="{{ badge_link.href }}"
                         {% if badge_link.target == '_blank' %}target="_blank" rel="noopener"{% endif %}
                         {% if badge_link.text != blank %}aria-label="{{ badge_link.text }}"{% endif %}>
                        {% image src: badge_image, size: 'small', class: 'footer-badge-image', alt: badge_link.text | default: '' %}
                      </a>
                    {% else %}
                      {% image src: badge_image, size: 'small', class: 'footer-badge-image', alt: '' %}
                    {% endif %}
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          {% endcase %}
        </div>
      {% endfor %}
    </div>

    {% if copyright_text != blank %}
      <div class="footer-copyright w-rte" data-setting="copyright">
        {{ copyright_html | raw }}
      </div>
    {% endif %}
  </div>
</footer>
