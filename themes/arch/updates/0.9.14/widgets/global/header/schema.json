          { "value": "url", "label": "tTheme:header.settings.header_links.destination_types.url" }
        ] },
        { "id": "presentation", "label": "tTheme:header.settings.header_links.columns.presentation", "type": "select", "layout": "full", "options": [
          { "value": "link", "label": "tTheme:header.settings.header_links.presentations.link" },
          { "value": "button", "label": "tTheme:header.settings.header_links.presentations.button" }
        ] }
