          { "value": "twitter", "label": "X / Twitter" }, { "value": "linkedin", "label": "LinkedIn" },
          { "value": "youtube", "label": "YouTube" }, { "value": "tiktok", "label": "TikTok" },
          { "value": "pinterest", "label": "Pinterest" }, { "value": "github", "label": "GitHub" },
          { "value": "mastodon", "label": "Mastodon" }, { "value": "bluesky", "label": "Bluesky" },
          { "value": "discord", "label": "Discord" }, { "value": "reddit", "label": "Reddit" },
          { "value": "telegram", "label": "Telegram" }, { "value": "threads", "label": "Threads" },
          { "value": "whatsapp", "label": "WhatsApp" }, { "value": "mail", "label": "Email" }
