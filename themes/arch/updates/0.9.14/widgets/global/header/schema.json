        { "id": "open_in_new_tab", "label": "tTheme:header.settings.header_social_links.columns.open_in_new_tab", "type": "checkbox", "default": "true" },
        { "id": "accessible_label", "label": "tTheme:header.settings.header_social_links.columns.accessible_label", "type": "text", "layout": "full" },
        { "id": "url", "label": "tTheme:header.settings.header_social_links.columns.url", "type": "text", "layout": "full" }
