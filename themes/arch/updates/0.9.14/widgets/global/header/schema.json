        { "id": "destination_page_uuid", "type": "hidden" },
        { "id": "destination_url", "type": "hidden" },
        { "id": "destination_type", "label": "tTheme:header.settings.header_links.columns.destination_type", "type": "select", "layout": "full", "options": [
