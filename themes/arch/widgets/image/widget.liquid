{% assign image_filename = widget.settings.image | split: '/' | last %}
{% assign image_media = mediaFiles[image_filename] %}
{% assign natural_width = image_media.width | default: 1600 | plus: 0 | at_least: 1 %}
{% assign natural_height = image_media.height | default: 900 | plus: 0 | at_least: 1 %}
{% assign transform = widget.settings.image_transform %}
{% assign transformed = false %}
{% if transform.version == 1 and transform.reference == 'intrinsic-fit' %}
  {% assign transformed = true %}
  {% assign width_scale = transform.scale.width | default: transform.scale.height | default: 100 | plus: 0 | at_least: 1 | at_most: 400 | divided_by: 100.0 %}
  {% assign height_scale = transform.scale.height | default: transform.scale.width | default: 100 | plus: 0 | at_least: 1 | at_most: 400 | divided_by: 100.0 %}
  {% assign inline_inset = transform.flowInset.inlinePercent | default: 0 | plus: 0 | at_least: 0 | at_most: 100 %}
  {% assign block_inset = transform.flowInset.blockPercent | default: 0 | plus: 0 | at_least: 0 | at_most: 400 | divided_by: 100.0 %}
{% endif %}
{% assign image_width = widget.settings.image_width_percent | default: 100 | plus: 0 | at_least: 10 | at_most: 100 | round %}
{% assign image_height = widget.settings.image_height_px | default: 0 | plus: 0 | at_least: 0 | at_most: 2000 | round %}
<section
  id="{{ widget.id }}"
  class="widget widget-image widget-{{ widget.id }}{% if widget.settings.top_spacing != 'auto' %} spacing-top-{{ widget.settings.top_spacing }}{% endif %}{% if widget.settings.bottom_spacing != 'auto' %} spacing-bottom-{{ widget.settings.bottom_spacing }}{% endif %}"
  data-widget-id="{{ widget.id }}"
  data-widget-type="image"
  data-image-width="{{ image_width }}"
  data-image-height="{{ image_height }}"
  data-image-transform-capable="true"
  data-image-units="2"
  data-image-source="{{ widget.settings.image }}"
  data-image-natural-width="{{ natural_width }}"
  data-image-natural-height="{{ natural_height }}"
  {% if transform.version == 2 %}
  data-image-transform-version="2"
  data-image-transform="{{ transform | json }}"
  {% endif %}
  {% if transformed %}
  data-image-transform-width="{{ transform.scale.width }}"
  data-image-transform-height="{{ transform.scale.height }}"
  data-image-transform-inline="{{ inline_inset }}"
  data-image-transform-block="{{ transform.flowInset.blockPercent | default: 0 }}"
  data-image-transform-version="1"
  {% endif %}
  {% if widget.index != null %}data-widget-index="{{ widget.index }}"{% endif %}
>
  <style>
    .widget-{{ widget.id }} {
      /* Reset default widget spacing for full-bleed layouts */
      margin-block: 0;

      {% if widget.settings.fullwidth %}
        padding-inline: 0;
      {% else %}
        padding-inline: 0;
        max-width: var(--container-max-width);
        margin-inline: auto;
      {% endif %}

      {% if widget.settings.fullwidth %}
      & .widget-container {
        max-width: none;
      }
      {% endif %}

      & .image-wrapper {
        width: 100%;
        display: block;
        {% unless widget.settings.fullwidth %}
        border-radius: var(--radius-lg);
        overflow: hidden;
        {% endunless %}

        & img {
          width: 100%;
          height: auto;
          display: block;
        }
      }

      & .image-link {
        display: block;
        width: 100%;
        text-decoration: none;
        {% unless widget.settings.fullwidth %}
        border-radius: var(--radius-lg);
        overflow: hidden;
        {% endunless %}

        &:hover img {
          opacity: 0.9;
          transition: opacity 0.2s ease;
        }
      }

      & .image-resize-target {
        width: {{ image_width }}%;
        margin-inline: auto;

        & img {
          width: 100%;
          max-width: 100%;
          {% if image_height > 0 %}
          height: {{ image_height }}px;
          object-fit: fill;
          {% else %}
          height: auto;
          {% endif %}
        }
      }

      {% if transformed %}
      & .widget-content { container-type: inline-size; }
      & .image-resize-target {
        --image-reference-width: min(100cqw, {{ natural_width }}px);
        --image-reference-height: calc(var(--image-reference-width) * {{ natural_height }} / {{ natural_width }});
        --image-visible-width: max(1px, min(calc(var(--image-reference-width) * {{ width_scale }}), calc(100cqw - {{ inline_inset }}cqw)));
        width: var(--image-visible-width);
        margin-inline-start: {{ inline_inset }}%;
        margin-inline-end: 0;
        padding-block-start: calc(var(--image-reference-height) * {{ block_inset }});
        & img {
          width: 100%;
          {% if transform.scale.width == nil or transform.scale.height == nil %}
          height: calc(var(--image-visible-width) * {{ natural_height }} / {{ natural_width }});
          {% else %}
          height: calc(var(--image-reference-height) * {{ height_scale }});
          {% endif %}
          object-fit: fill;
        }
      }
      {% endif %}

      {% if transform.version == 2 %}
      & .widget-content { container-type: inline-size; }
      & .image-resize-target {
        --image-reference-width: min(100cqw, {{ natural_width }}px);
        --image-reference-height: calc(var(--image-reference-width) * {{ natural_height }} / {{ natural_width }});
        {% if transform.dimensions.width.unit == 'px' %}
        --image-requested-width: {{ transform.dimensions.width.value | default: 1 }}px;
        {% else %}
        --image-requested-width: calc(var(--image-reference-width) * {{ transform.dimensions.width.value | default: 100 | divided_by: 100.0 }});
        {% endif %}
        {% if transform.dimensions.height.unit == 'px' %}
        --image-requested-height: {{ transform.dimensions.height.value | default: 1 }}px;
        {% else %}
        --image-requested-height: calc(var(--image-reference-height) * {{ transform.dimensions.height.value | default: 100 | divided_by: 100.0 }});
        {% endif %}
        {% if transform.dimensions.width.value == nil %}
          {% if transform.dimensions.height.value == nil %}
        --image-visible-width: min(100cqw, var(--image-reference-width));
          {% else %}
        --image-visible-width: max(1px, min(100cqw, calc(var(--image-requested-height) * {{ natural_width }} / {{ natural_height }})));
          {% endif %}
        {% else %}
        --image-visible-width: max(1px, min(100cqw, var(--image-requested-width)));
        {% endif %}
        {% assign align_factor = 0 %}
        {% if transform.alignment == 'center' %}{% assign align_factor = 0.5 %}{% elsif transform.alignment == 'right' %}{% assign align_factor = 1 %}{% endif %}
        --image-inline-offset: max(0px, min(calc(100cqw - var(--image-visible-width)), calc((100cqw - var(--image-visible-width)) * {{ align_factor }} + {{ transform.flowInset.inlinePercent }}cqw)));
        width: var(--image-visible-width);
        margin-inline-start: var(--image-inline-offset);
        margin-inline-end: 0;
        padding-block-start: calc(var(--image-reference-height) * {{ transform.flowInset.blockPercent | divided_by: 100.0 }});
        & img {
          width: 100%;
          {% if transform.dimensions.width.value == nil or transform.dimensions.height.value == nil %}
          height: calc(var(--image-visible-width) * {{ natural_height }} / {{ natural_width }});
          {% else %}
          height: var(--image-requested-height);
          {% endif %}
          object-fit: fill;
        }
      }
      {% endif %}

      & .image-figure {
        margin: 0;
      }

      & .image-caption {
        padding: var(--space-sm) var(--section-padding-inline) 0;
        text-align: center;
      }
    }
  </style>

  {% assign image_sizes = '100vw' %}
  {% unless widget.settings.fullwidth %}
    {% assign image_sizes = '(max-width: 1420px) 100vw, 1420px' %}
  {% endunless %}
  <div class="widget-container">
    <div class="widget-content">
      <div class="image-resize-target" data-image-resize-target>
      {% if widget.settings.image != blank %}
        {% assign caption = widget.settings.image | media_meta: 'caption' %}
        <figure class="image-figure">
          {% if widget.settings.link.href != blank %}
            <a
              href="{{ widget.settings.link.href }}"
              class="image-link reveal reveal-fade"
              {% if widget.settings.link.target == '_blank' %}
                target="_blank" rel="noopener"
              {% endif %}
              data-setting="link"
            >
              {% image src: widget.settings.image, size: 'large', srcset: true, sizes: image_sizes, class: 'widget-image' %}
            </a>
          {% else %}
            <div class="image-wrapper reveal reveal-fade">
              {% image src: widget.settings.image, size: 'large', srcset: true, sizes: image_sizes, class: 'widget-image' %}
            </div>
          {% endif %}
          {% if caption != blank %}
            <figcaption class="image-caption w-meta t-sm reveal reveal-fade">{{ caption }}</figcaption>
          {% endif %}
        </figure>
      {% else %}
        <div class="image-wrapper reveal reveal-fade">
          {% placeholder_image %}
        </div>
      {% endif %}
      </div>
    </div>
  </div>
</section>
