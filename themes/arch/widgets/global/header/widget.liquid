<a href="#main-content" class="visually-hidden skip-link">{{ widget.settings.skip_link_text | default: 'Skip to main content' }}</a>

<header id="{{ widget.id }}" class="widget widget-site-header color-scheme-{{ widget.settings.color_scheme }}{% if widget.settings.sticky %} header-sticky{% endif %}{% if widget.settings.three_region_enabled %} header-v1{% endif %}{% if widget.settings.show_bottom_border == false or widget.settings.show_bottom_border == 'false' %} header-no-bottom-border{% endif %}" data-widget-id="{{ widget.id }}" data-widget-type="header"{% unless widget.settings.color_scheme == 'standard-primary' %}style="--widget-bg-color: var(--bg-primary);"{% endunless %}>

  <style>
    .widget-site-header {
      padding-inline: min({{ widget.settings.horizontal_header_padding | default: 16 }}px, max(0px, calc(50% - 120px)));
    }
    .widget-site-header .header-logo-image {
      max-width: {{ widget.settings.logoMaxWidth | default: 150 }}px;
      height: auto;
      display: block;
    }
    .widget-site-header .header-logo img[src$=".svg"],
    .widget-site-header .header-logo-image[src$=".svg"] {
      width: auto;
      height: auto;
      max-height: {{ widget.settings.logoMaxWidth | default: 150 }}px;
      min-height: 40px;
      object-fit: contain;
      vertical-align: middle;
    }
    .widget-site-header .header-logo {
      line-height: 0;
    }
    .widget-site-header .header-logo img {
      display: inline-block;
    }
    .widget-site-header.header-v1 .header-inner--three-region {
      display: grid;
      grid-template-columns: repeat(3, minmax(max-content, 1fr));
      align-items: center;
      gap: var(--space-md);
    }
    .widget-site-header.header-v1 .header-region {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
      min-width: 0;
    }
    .widget-site-header.header-v1 .header-region--left { justify-content: flex-start; }
    .widget-site-header.header-v1 .header-region--center { justify-content: center; }
    .widget-site-header.header-v1 .header-region--right { justify-content: flex-end; }
    .widget-site-header.header-v1 .header-three-region-nav {
      display: flex;
      justify-content: inherit;
      min-width: 0;
    }
    .widget-site-header.header-v1 .header-three-region-nav .nav-list,
    .widget-site-header.header-v1 .header-three-region-social {
      display: flex;
      align-items: center;
      justify-content: inherit;
      flex-wrap: wrap;
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .widget-site-header.header-v1 .header-three-region-nav .nav-list { flex-wrap: nowrap; }
    .widget-site-header.header-v1 .header-three-region-nav .nav-list {
      column-gap: var(--header-nav-item-spacing, var(--space-xs));
      row-gap: var(--space-xs);
    }
    .widget-site-header.header-v1 .header-three-region-social {
      column-gap: var(--header-social-icon-spacing, var(--space-xs));
      row-gap: var(--space-xs);
    }
    .widget-site-header.header-v1 .header-three-region-nav .nav-item { position: relative; }
    .widget-site-header.header-v1 .header-three-region-nav .nav-link {
      display: inline-flex;
      align-items: center;
      padding: var(--space-sm) var(--space-md);
      font-family: inherit;
      font-size: calc(var(--font-size-base) * var(--body-scale));
      font-weight: var(--typography-body_font-weight, 400);
      line-height: var(--line-height-normal);
      letter-spacing: inherit;
      color: var(--header-nav-top-link-color);
      text-decoration: none;
      border-radius: var(--radius-button);
      white-space: nowrap;
    }
    .widget-site-header.header-v1 .header-three-region-nav .nav-link:hover,
    .widget-site-header.header-v1 .header-three-region-nav .nav-link:focus-visible {
      color: var(--header-nav-top-link-hover-color);
      background: var(--header-nav-top-link-hover-bg);
    }
    .widget-site-header.header-v1 .header-three-region-nav .nav-link--button {
      font-family: inherit;
      font-size: calc(var(--font-size-sm) * var(--body-scale));
      font-weight: var(--typography-body_font-weight, 400);
      line-height: var(--line-height-normal);
      letter-spacing: inherit;
      color: var(--accent-text);
      background: var(--accent);
    }
    .widget-site-header.header-no-bottom-border { border-block-end: 0; }
    .widget-site-header.header-v1 .header-three-region-nav .nav-link--button:hover,
    .widget-site-header.header-v1 .header-three-region-nav .nav-link--button:focus-visible {
      color: var(--accent-text);
      filter: brightness(.94);
    }
    .widget-site-header.header-v1 .header-three-region-social .social-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 3.6rem;
      min-height: 3.6rem;
      color: var(--text-content);
      border-radius: var(--radius-sm);
      border: 0;
      outline: none;
      box-shadow: none;
      background: transparent;
      text-decoration: none;
    }
    .widget-site-header.header-v1 .header-three-region-social .social-link:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
    .widget-site-header.header-v1 .header-three-region-social .social-link:hover,
    .widget-site-header.header-v1 .header-three-region-social .social-link:focus-visible {
      color: var(--accent);
      background: transparent;
      border: 0;
    }
    .widget-site-header.header-v1 .header-three-region-social svg {
      width: var(--header-social-icon-size, 32px);
      height: auto;
      max-height: var(--header-social-icon-size, 32px);
      flex: none;
    }
    .widget-site-header.header-v1 .header-contact--three-region {
      display: flex;
      flex-direction: column;
      line-height: var(--line-height-normal);
    }
    @media (max-width: 989px) {
      .widget-site-header.header-v1 .header-inner--three-region { grid-template-columns: minmax(0, 1fr); }
      .widget-site-header.header-v1 .header-region { width: 100%; flex-wrap: wrap; }
      .widget-site-header.header-v1 .header-three-region-nav .nav-list { flex-wrap: wrap; }
      .widget-site-header.header-v1 .header-region--left { justify-content: flex-start; }
      .widget-site-header.header-v1 .header-region--center { justify-content: center; }
      .widget-site-header.header-v1 .header-region--right { justify-content: flex-end; }
      .widget-site-header.header-v1 .header-nav {
        position: static; inset: auto; width: auto; max-width: 100%; height: auto;
        padding: 0; overflow: visible; transform: none; box-shadow: none; background: transparent;
      }
    }
    {% unless widget.settings.full_width %}
    .widget-site-header .header-inner {
      max-width: var(--container-max-width);
      margin-inline: auto;
    }
    {% endunless %}
  </style>

  {% if widget.settings.three_region_enabled %}
  <div class="header-inner header-inner--three-region">
    <div class="header-region header-region--left">
      {% if widget.settings.logo_region == 'left' %}
        {% render 'header-v1-logo', header_settings: widget.settings %}
        {% unless widget.settings.show_contact_details == false or widget.settings.show_contact_details == 'false' %}{% render 'header-v1-contact', header_settings: widget.settings %}{% endunless %}
      {% endif %}
      {% if widget.settings.navigation_region == 'left' %}{% render 'header-v1-navigation', header_settings: widget.settings %}{% endif %}
      {% if widget.settings.social_region == 'left' %}{% render 'header-v1-social', header_settings: widget.settings %}{% endif %}
    </div>
    <div class="header-region header-region--center">
      {% if widget.settings.logo_region == 'center' %}
        {% render 'header-v1-logo', header_settings: widget.settings %}
        {% unless widget.settings.show_contact_details == false or widget.settings.show_contact_details == 'false' %}{% render 'header-v1-contact', header_settings: widget.settings %}{% endunless %}
      {% endif %}
      {% if widget.settings.navigation_region == 'center' %}{% render 'header-v1-navigation', header_settings: widget.settings %}{% endif %}
      {% if widget.settings.social_region == 'center' %}{% render 'header-v1-social', header_settings: widget.settings %}{% endif %}
    </div>
    <div class="header-region header-region--right">
      {% if widget.settings.logo_region == 'right' %}
        {% render 'header-v1-logo', header_settings: widget.settings %}
        {% unless widget.settings.show_contact_details == false or widget.settings.show_contact_details == 'false' %}{% render 'header-v1-contact', header_settings: widget.settings %}{% endunless %}
      {% endif %}
      {% if widget.settings.navigation_region == 'right' %}{% render 'header-v1-navigation', header_settings: widget.settings %}{% endif %}
      {% if widget.settings.social_region == 'right' %}{% render 'header-v1-social', header_settings: widget.settings %}{% endif %}
      {% if widget.settings.show_language_switcher %}
        {% render 'language-switcher', translations: page.translations, landmark: true, label: widget.settings.language_switcher_label %}
      {% endif %}
    </div>
  </div>
  {% else %}
  <div class="header-inner{% if widget.settings.center_nav %} header-center-nav{% endif %}">
    <div class="header-branding">
      <a href="{{ 'index' | page_url }}" class="header-logo">
        {% if widget.settings.logoImage != blank and widget.settings.show_logo_image %}
          {% image src: widget.settings.logoImage, size: 'medium', class: 'header-logo-image header-logo-default', lazy: false %}
          {% if widget.settings.transparent_logo != blank %}
            {% image src: widget.settings.transparent_logo, size: 'medium', class: 'header-logo-image header-logo-transparent', lazy: false %}
          {% else %}
            {% image src: widget.settings.logoImage, size: 'medium', class: 'header-logo-image header-logo-transparent', lazy: false %}
          {% endif %}
        {% elsif widget.settings.show_logo_text %}
          <span data-setting="logoText">{{ widget.settings.logoText | default: 'Widgetizer' }}</span>
        {% endif %}
      </a>

      {% unless widget.settings.show_contact_details == false or widget.settings.show_contact_details == 'false' %}
      {% if widget.settings.contact_position != 'menu' %}
        {% if widget.settings.contactDetailsLine1 != blank or widget.settings.contactDetailsLine2 != blank %}
          <div class="header-contact">
            {% if widget.settings.contactDetailsLine1 != blank %}
              <span class="header-contact-line t-sm t-body-bold t-heading" data-setting="contactDetailsLine1">
                {{ widget.settings.contactDetailsLine1 }}
              </span>
            {% endif %}
            {% if widget.settings.contactDetailsLine2 != blank %}
              <span class="header-contact-line t-xs t-muted" data-setting="contactDetailsLine2">
                {{ widget.settings.contactDetailsLine2 }}
              </span>
            {% endif %}
          </div>
        {% endif %}
      {% endif %}
      {% endunless %}
    </div>

    <div class="header-actions">
      <nav class="header-nav" id="main-navigation" aria-label="{{ widget.settings.nav_label | default: 'Primary' }}">
        <div class="nav-close">
          <span class="nav-close-title">{{ widget.settings.menu_title | default: 'Menu' }}</span>
          <button type="button" class="nav-close-btn" aria-label="{{ widget.settings.menu_close_label | default: 'Close menu' }}">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M18 6l-12 12" />
              <path d="M6 6l12 12" />
            </svg>
          </button>
        </div>
        {% if widget.settings.headerNavigation %}
          {% render 'menu',
            menu: widget.settings.headerNavigation,
            skip_nav: true,
            class_list: 'nav-list',
            class_item: 'nav-item',
            class_link: '',
            class_submenu: 'nav-submenu',
            class_has_submenu: 'has-submenu'
          %}
        {% endif %}
        {% if widget.settings.ctaButtonLink.text != blank %}
          <a href="{{ widget.settings.ctaButtonLink.href | default: '#' }}" class="widget-button widget-button-full widget-button-large mobile-cta {% if widget.settings.ctaButtonStyle == 'primary' %}widget-button-primary{% else %}widget-button-secondary{% endif %}" {% if widget.settings.ctaButtonLink.target == '_blank' %}target="_blank" rel="noopener noreferrer"{% endif %}>
            {{ widget.settings.ctaButtonLink.text }}
          </a>
        {% endif %}
        {% unless widget.settings.show_contact_details == false or widget.settings.show_contact_details == 'false' %}
        {% if widget.settings.contactDetailsLine1 != blank or widget.settings.contactDetailsLine2 != blank %}
          <div class="header-contact header-contact-mobile">
            {% if widget.settings.contactDetailsLine1 != blank %}
              <span class="header-contact-line t-lg t-body-bold t-heading" data-setting="contactDetailsLine1">
                {{ widget.settings.contactDetailsLine1 }}
              </span>
            {% endif %}
            {% if widget.settings.contactDetailsLine2 != blank %}
              <span class="header-contact-line t-xs t-muted" data-setting="contactDetailsLine2">
                {{ widget.settings.contactDetailsLine2 }}
              </span>
            {% endif %}
          </div>
        {% endif %}
        {% endunless %}
        {% if widget.settings.show_language_switcher %}
          {% render 'language-switcher', translations: page.translations, landmark: false %}
        {% endif %}
      </nav>

      <div class="header-end">
        {% unless widget.settings.show_contact_details == false or widget.settings.show_contact_details == 'false' %}
        {% if widget.settings.contact_position == 'menu' %}
          {% if widget.settings.contactDetailsLine1 != blank or widget.settings.contactDetailsLine2 != blank %}
            <div class="header-contact header-contact-right">
              {% if widget.settings.contactDetailsLine1 != blank %}
                <span class="header-contact-line t-sm t-body-bold t-heading" data-setting="contactDetailsLine1">
                  {{ widget.settings.contactDetailsLine1 }}
                </span>
              {% endif %}
              {% if widget.settings.contactDetailsLine2 != blank %}
                <span class="header-contact-line t-xs t-muted" data-setting="contactDetailsLine2">
                  {{ widget.settings.contactDetailsLine2 }}
                </span>
              {% endif %}
            </div>
          {% endif %}
        {% endif %}
        {% endunless %}

        {% if widget.settings.ctaButtonLink.text != blank %}
        <a href="{{ widget.settings.ctaButtonLink.href | default: '#' }}" class="widget-button desktop-cta {% if widget.settings.ctaButtonStyle == 'primary' %}widget-button-primary{% else %}widget-button-secondary{% endif %}" {% if widget.settings.ctaButtonLink.target == '_blank' %}target="_blank" rel="noopener noreferrer"{% endif %}>
          {{ widget.settings.ctaButtonLink.text }}
        </a>
        {% endif %}

        {% if widget.settings.show_language_switcher %}
          {% render 'language-switcher', translations: page.translations, landmark: true, label: widget.settings.language_switcher_label %}
        {% endif %}
      </div>

      <button
        type="button"
        class="menu-toggle"
        aria-label="{{ widget.settings.menu_title | default: 'Menu' }}"
        aria-expanded="false"
        aria-controls="main-navigation"
      >
        <svg
          class="icon-menu"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none" />
          <path d="M4 6l16 0" />
          <path d="M4 12l16 0" />
          <path d="M4 18l16 0" />
        </svg>
        <svg
          class="icon-close"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none" />
          <path d="M18 6l-12 12" />
          <path d="M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>
  {% endif %}
</header>
